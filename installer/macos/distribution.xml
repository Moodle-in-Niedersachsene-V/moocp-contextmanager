<?xml version="1.0" encoding="utf-8"?>
<!--
  Installer des Plugins für macOS (Vorlage für productbuild). installer_mac.sh
  ersetzt @KURZNAME@, @VERSION@, @ANZEIGENAME@ und @KENNUNG@ mit den Werten aus
  plugin.json und baut damit <kurzname>_setup_<Version>.pkg.

  Was moocp vom Installer eines Plugins erwartet (README von moocp, „Plugins“),
  und wo es hier steht:
  - Er legt das Plugin nach plugins/<kurzname> im Einstellungsordner von moocp,
    ~/Library/Application Support/moocp, und nirgends sonst hin (domains: nur
    der Benutzerordner, ohne Administratorrechte; Ziel aus installer_mac.sh).
  - Er bricht ab, wenn moocp fehlt (installation-check, dazu scripts/preinstall).
  - Er ersetzt den Plugin-Ordner ganz (scripts/preinstall).
  - Er liest und schreibt sonst nichts im Einstellungsordner von moocp;
    Zustimmung und Skills erledigt moocp selbst.
  Das Programm des Plugins ist für Apple Silicon übersetzt (dart compile exe
  baut nur für den eigenen Prozessor), daher nur arm64.
-->
<installer-gui-script minSpecVersion="2">
  <title>moocp-Plugin @ANZEIGENAME@ @VERSION@</title>
  <welcome file="willkommen.html" mime-type="text/html"/>
  <conclusion file="fertig.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <installation-check script="moocpVorhanden()"/>
  <script><![CDATA[
// moocp gilt als vorhanden, wenn es seinen Einstellungsordner gibt (moocp lief
// schon einmal). Gelesen wird keine Datei, nur nachgesehen, ob es den Ordner gibt.
function moocpVorhanden() {
  var home = system.env.HOME;
  if (home && system.files.fileExistsAtPath(home + '/Library/Application Support/moocp')) {
    return true;
  }
  my.result.type = 'Fatal';
  my.result.title = 'moocp fehlt';
  my.result.message = 'moocp ist auf diesem Mac nicht eingerichtet. Bitte zuerst moocp installieren und einmal starten, dann das Plugin installieren.';
  return false;
}
  ]]></script>
  <choices-outline>
    <line choice="plugin"/>
  </choices-outline>
  <choice id="plugin" visible="false" title="moocp-Plugin @ANZEIGENAME@">
    <pkg-ref id="@KENNUNG@"/>
  </choice>
  <pkg-ref id="@KENNUNG@" version="@VERSION@" onConclusion="none">plugin.pkg</pkg-ref>
</installer-gui-script>

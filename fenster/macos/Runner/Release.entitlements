<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ohne Sandbox: Das Fenster liest und schreibt die Einstellungen im
	     Datenordner des Plugins (~/Library/Application Support/moocp-contextmanager),
	     ruft `security` für den Schlüsselbund auf und prüft die Verbindung zum
	     WebDAV-Server, genau wie das Plugin selbst. In der Sandbox läge der
	     Datenordner im Container des Fensters, und das Plugin fände die
	     Einstellungen nicht. Das Fenster kommt nicht aus dem App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
